## traefik
PUID="{{ apps_puid }}"
PGID="{{ apps_pgid }}"
TZ="{{ apps_tz }}"
USERDIR="{{ apps_userdir }}"
DOCKERDIR="{{ apps_dockerdir }}"
DATADIR="{{ apps_datadir }}"
HOSTNAME="{{ apps_hostname }}"
DOMAINNAME_1="{{ apps_domainname }}"
LOCAL_IPS="{{ apps_local_ips }}"
CLOUDFLARE_IPS="{{ apps_cloudflare_ips }}"

##authentik
AUTHENTIK_POSTGRESQL__USER={{ apps_authentik_pg_user }}
AUTHENTIK_POSTGRESQL__PASSWORD={{ apps_authentik_pg_password }}
AUTHENTIK_POSTGRESQL__NAME={{ apps_authentik_pg_name }}
AUTHENTIK_SECRET_KEY={{ apps_authentik_secret_key }}

##cloudflare-ddns
DOMAINNAME_1="{{ apps_domainname }}"
DOCKERDIR="{{ apps_dockerdir }}"

# socket-proxy
docker_privileged_mode="{{ apps_docker_privileged_mode }}"

##portainer
DOMAINNAME_1="{{ apps_domainname }}"
DOCKERDIR="{{ apps_dockerdir }}"
TZ="{{ apps_tz }}"

##nextcloud
nextcloud_db_root_password="{{ apps_nextcloud_db_root_password }}"
nextcloud_db_password="{{ apps_nextcloud_db_password }}"
nextcloud_admin_password="{{ apps_nextcloud_admin_password }}"